# Configuración local de desarrollo
MONGODB_URI=mongodb://127.0.0.1:27017/klave
NEXTAUTH_SECRET=poné-una-clave-larga-y-aleatoria
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Las cuentas nuevas quedan pendientes hasta confirmar el primer pago mensual.
# ALLOW_DIRECT_REGISTER ya no habilita iglesias sin pago.

# Opcionales
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# También se aceptan GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET.
# Redirect URI local: http://localhost:3000/api/auth/callback/google
# Google: configurar /api/auth/callback/google como redirect URI en Google Cloud.

# Suscripción mensual — no activar sin probar con cuentas de prueba de Mercado Pago.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_LIVE_MODE=false
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_COLLECTOR_ID=
# MERCADOPAGO_MONTHLY_PRICE= (importe mensual en ARS, sin separador de miles)
# NEXT_PUBLIC_APP_URL debe ser la URL pública HTTPS al activar pagos.
# Webhook: /api/payments/mercadopago/webhook
# Eventos: subscription_preapproval, subscription_authorized_payment, payment.

# Compatibilidad con el webhook de invitaciones anterior (no activa suscripciones):
# PAYMENT_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Klave <no-reply@localhost>
